  "login_url": "https://www.erp321.com/login.aspx?refer=https%3A%2F%2Fwww.erp321.com%2Fepaas",
  "login": {
    "mode": "manual",
    "completion_prompt": "请先在浏览器中登录聚水潭并进入商品多店铺铺货页，完成后按回车继续..."
