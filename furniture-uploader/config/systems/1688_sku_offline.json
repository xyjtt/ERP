{
  "system": "1688_sku_offline",
  "display_name": "1688 SKU 下架",
  "login_url": "https://login.1688.com/",
  "management_url": "https://work.1688.com/?_path_=sellerPro/2017sellerbase_offer/shasngpinguanlinew&tab=all&q=&filterOfferId=",
  "login": {
    "mode": "manual",
    "completion_prompt": "请先登录目标 1688 店铺并进入商品管理页，确认当前店铺无误后按回车继续..."
  },
  "input": {
    "sheet_name": "停产下架通知-链接维度",
    "filters": {
      "platform": "Alibaba",
      "handling": "全渠道下架"
    },
    "columns": {
      "store_name": "店铺名称",
      "platform": "平台",
      "product_id": "商品ID",
      "platform_store_item_code": "平台店铺商品编码",
      "online_sku": "线上商品编码",
      "handling": "处理说明",
      "replacement_sku": "可替换商品编码（新）",
      "change_image": "是否换图"
    },
    "column_aliases": {
      "replacement_sku": [
        "可替换商品编码"
      ]
    }
  },
  "execution": {
    "operation": "offline",
    "max_retry": 1,
    "allow_multi_store_batch": false,
    "require_store_account_mapping": true,
    "require_browser_profile_exists": true,
    "auto_login_fallback": {
      "enabled": true,
      "timeout_seconds": 300,
      "max_attempts_per_store": 1
    },
    "stop_store_on_error_categories": [
      "store_mismatch"
    ],
    "non_retryable_error_categories": [
      "task_not_found",
      "sku_not_found",
      "product_unavailable",
      "sole_sku_requires_product_offline",
      "campaign_restriction",
      "delivery_service_backfill_failed",
      "submit_blocked_before_request"
    ],
    "safety": {
      "edit_entry_mode": "management",
      "assert_store_context_before_direct_edit": true,
      "require_store_context_selector": true,
      "verify_edit_page_identity": true,
      "verify_edit_url_product_id": true,
      "verify_product_id_in_page_body": false
    },
    "store_accounts": [
      {
        "store_name": "阿里巴巴-广州淘淘家居有限公司",
        "store_aliases": [
          "阿里巴巴_广州淘淘家居有限公司",
          "广州淘淘家居有限公司",
          "广州淘淘家居",
          "木刻理想"
        ],
        "account_key": "muke_lixiang",
        "browser_type": "edge",
        "browser_profile_dir": "D:/script_1688/.local/browser_profiles/1688_profile_muke_lixiang"
      },
      {
        "store_name": "阿里巴巴-广州沃来贸易有限公司",
        "store_aliases": [
          "阿里巴巴_广州沃来贸易有限公司",
          "广州沃来贸易有限公司",
          "广州沃来家具"
        ],
        "account_key": "guangzhou_wolai",
        "browser_type": "edge",
        "browser_profile_dir": "D:/script_1688/.local/browser_profiles/1688_profile_guangzhou_wolai"
      },
      {
        "store_name": "阿里巴巴-常州工莱家具",
        "store_aliases": [
          "常州工莱家具"
        ],
        "account_key": "gonglai",
        "browser_type": "edge",
        "browser_profile_dir": "D:/script_1688/.local/browser_profiles/1688_profile_gonglai"
      },
      {
        "store_name": "阿里巴巴-常州乐畅家居有限公司",
        "store_aliases": [
          "常州乐畅家居有限公司",
          "乐畅家具"
        ],
        "account_key": "lechang",
        "browser_type": "edge",
        "browser_profile_dir": "D:/script_1688/.local/browser_profiles/1688_profile_lechang"
      }
    ]
  },
  "scan": {
    "watch_dir": "D:/script_files/1688/shared/sample-data",
    "processed_dir": "D:/script_files/1688/archive/processed",
    "failed_dir": "D:/script_files/1688/archive/failed",
    "registry_path": "D:/script_files/1688/archive/processed/registry.jsonl"
  },
  "reporting": {
    "run_report_dir": "logs/sku_offline/run_reports"
  },
  "notifications": {
    "dingtalk": {
      "enabled": false,
      "webhook_env": "DINGTALK_WEBHOOK",
      "secret_env": "DINGTALK_SECRET",
      "webhook": "",
      "secret": ""
    }
  },
  "workflow": {
    "pre_submit_backfill": {
      "enabled": true,
      "mode": "delivery_service_only",
      "block_on_missing": true
    },
    "selectors": {
      "current_store_name": {
        "by": "xpath",
        "value": "//*[contains(@class, 'user-name')]//a | //*[contains(@class, 'user-name-box')]//a"
      },
      "management_iframe": {
        "by": "xpath",
        "value": "//iframe[contains(@src, 'offer.1688.com/app/pages-group/manage-home/index.html')]"
      },
      "all_products_tab": {
        "by": "xpath",
        "value": "//*[@role='tab' and normalize-space(.)='全部'] | //*[contains(@class, 'tabs-tab') and normalize-space(.)='全部'] | //*[contains(@class, 'next-tabs-tab') and normalize-space(.)='全部'] | //*[contains(@class, 'ant-tabs-tab') and normalize-space(.)='全部']"
      },
      "product_id_input": {
        "by": "xpath",
        "value": "//div[contains(concat(' ', normalize-space(@class), ' '), ' search-field ')][.//span[contains(concat(' ', normalize-space(@class), ' '), ' search-label ') and (contains(normalize-space(.), '商品 ID') or contains(normalize-space(.), '商品ID'))]]//input[contains(concat(' ', normalize-space(@class), ' '), ' ant-input ') and @type='text']"
      },
      "title_sku_input": {
        "by": "xpath",
        "value": "//div[contains(concat(' ', normalize-space(@class), ' '), ' search-field ')][.//span[contains(concat(' ', normalize-space(@class), ' '), ' search-label ') and contains(normalize-space(.), '标题/货号')]]//input[contains(concat(' ', normalize-space(@class), ' '), ' ant-input ') and @type='text']"
      },
      "search_button": {
        "by": "xpath",
        "value": "//button[@data-click='search' or normalize-space(.)='搜索' or .//span[contains(normalize-space(.), '搜索')]]"
      },
      "product_result_row": {
        "by": "xpath",
        "value": "//tr[@data-row-key='{product_id}' or .//td[normalize-space(.)='{product_id}' or contains(normalize-space(.), '{product_id}')]]"
      },
      "edit_button_in_row": {
        "by": "xpath",
        "value": ".//a[contains(@class, 'modify-link') or contains(normalize-space(.), '修改详情')]"
      },
      "edit_button": {
        "by": "xpath",
        "value": "//a[contains(normalize-space(.), '修改详情')]"
      },
      "sales_info_anchor": {
        "by": "xpath",
        "value": "//*[contains(normalize-space(.), '销售信息')]"
      },
      "sku_row": {
        "by": "xpath",
        "value": "//tr[.//input[@value='{online_sku}'] or .//td[contains(normalize-space(.), '{online_sku}')] or .//*[contains(normalize-space(.), '{online_sku}')]]"
      },
      "sku_switch": {
        "by": "xpath",
        "value": ".//*[@role='switch' or self::button][contains(normalize-space(.), '上架') or contains(normalize-space(.), '下架') or contains(@class, 'switch')]"
      },
      "submit_button": {
        "by": "id",
        "value": "submitFormButton"
      },
      "confirm_button": {
        "by": "xpath",
        "value": "//button[contains(normalize-space(.), '确定') or contains(normalize-space(.), '确认')]"
      }
    },
    "success_detection": {
      "enabled": true,
      "required": false,
      "timeout_seconds": 8,
      "keywords": [
        "成功",
        "发布成功",
        "保存成功",
        "提交成功"
      ],
      "page_keywords": [
        "修改成功",
        "商品已提交审核",
        "未上架产品-审核中"
      ],
      "message_selector": {
        "by": "css",
        "value": ".ant-message-notice-content, .next-message-wrapper, .next-toast-notice, .ant-notification-notice-description"
      }
    },
    "error_detection": {
      "enabled": true,
      "timeout_seconds": 2,
      "validation_keywords": [
        "不能为空",
        "请完善",
        "请填写",
        "请选择",
        "必填",
        "请先完善"
      ],
      "keywords": [
        "失败",
        "错误",
        "验证码",
        "风控",
        "请稍后再试",
        "无权限"
      ],
      "message_selector": {
        "by": "css",
        "value": ".ant-message-notice-content, .ant-notification-notice-description, .ant-modal-body, .next-dialog-body"
      },
      "close_selector": {
        "by": "css",
        "value": ".ant-modal-close, .next-dialog-close"
      }
    },
    "post_submit_verification": {
      "enabled": true,
      "accept_review_submission": true,
      "review_submission_keywords": [
        "修改成功",
        "商品已提交审核"
      ],
      "timeout_seconds": 150,
      "refresh_interval_seconds": 15,
      "initial_wait_seconds": 8
    }
  }
}
