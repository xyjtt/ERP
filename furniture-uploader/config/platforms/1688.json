{
  "platform": "1688",
  "display_name": "1688",
  "login_url": "https://login.1688.com/",
  "publish_url": "",
  "required_fields": [
    "title",
    "price",
    "quantity",
    "platform_category",
    "main_image"
  ],
  "field_mapping": {
    "title": "商品标题",
    "subtitle": "副标题",
    "brand": "品牌",
    "material": "材质",
    "size": "尺寸",
    "color": "颜色",
    "price": "价格",
    "quantity": "库存",
    "main_image": "主图",
    "detail_images": "详情图",
    "description": "商品描述"
  },
  "login": {
    "mode": "manual",
    "completion_prompt": "请在浏览器中手动完成 1688 登录，进入商家后台后按回车继续..."
  },
  "publish": {
    "open_each_product": true,
    "auto_save_draft": false,
    "auto_submit": false,
    "pause_before_submit": true,
    "pre_submit_error_detection": {
      "enabled": true,
      "timeout_seconds": 0,
      "keywords": [
        "发布失败",
        "产品规格包含表情符号",
        "资料失效",
        "日志失效"
      ],
      "message_selector": {
        "by": "css",
        "value": "#guid-assistBoard .info-list li div, .ant-message-notice-content, .ant-notification-notice-description, .ant-modal-body, .next-dialog-body"
      },
      "close_selector": {
        "by": "css",
        "value": ".ant-modal-root .ant-modal-close, .next-dialog-close, .ui-dialog-titlebar-close"
      }
    },
    "submit_error_detection": {
      "enabled": true,
      "timeout_seconds": 3,
      "keywords": [
        "发布失败",
        "产品规格包含表情符号",
        "资料失效",
        "日志失效"
      ],
      "message_selector": {
        "by": "css",
        "value": "#guid-assistBoard .info-list li div, .ant-message-notice-content, .ant-notification-notice-description, .ant-modal-body, .next-dialog-body"
      },
      "close_selector": {
        "by": "css",
        "value": ".ant-modal-root .ant-modal-close, .next-dialog-close, .ui-dialog-titlebar-close"
      }
    },
    "submit_request_trace": {
      "enabled": true,
      "timeout_seconds": 5,
      "capture_body_chars": 4000,
      "response_failure_keywords": [
        "绯荤粺閿欒",
        "鍙戝竷澶辫触",
        "淇濆瓨澶辫触"
      ]
    },
    "submit_verification": {
      "enabled": false,
      "settle_seconds": 1.2,
      "check_page_text": true,
      "require_leave_publish_page": false,
      "require_success_signal": false,
      "forbidden_url_keywords": [
        "login.1688.com"
      ],
      "success_url_keywords": [
        "/popular/result.htm",
        "/offer/"
      ],
      "success_text_keywords": [
        "鍙戝竷鎴愬姛",
        "鎻愪氦鎴愬姛"
      ]
    },
    "submit_selector": {
      "by": "css",
      "value": "#submitFormButton"
    },
    "draft_selector": {
      "by": "css",
      "value": "#saveDraftButton"
    },
    "draft_error_detection": {
      "enabled": true,
      "timeout_seconds": 3,
      "keywords": [
        "鍙戝竷澶辫触",
        "浜у搧瑙勬牸鍖呭惈琛ㄦ儏绗﹀彿",
        "璧勬枡澶辨晥",
        "鏃ュ織澶辨晥"
      ],
      "message_selector": {
        "by": "css",
        "value": "#guid-assistBoard .info-list li div, .ant-message-notice-content, .ant-notification-notice-description, .ant-modal-body, .next-dialog-body"
      },
      "close_selector": {
        "by": "css",
        "value": ".ant-modal-root .ant-modal-close, .next-dialog-close, .ui-dialog-titlebar-close"
      }
    },
    "draft_confirm_blocker_keywords": [
      "规格数据会被清空",
      "规格有必填项未填写",
      "必填项未填写"
    ],
    "draft_request_patch_retry_modes": [
      "full",
      "identity_only"
    ],
    "draft_buyer_protection_allow_fallback": false,
    "submit_reapply_nonpersistent_fields": [
      "delivery_service",
      "send_address",
      "logistics",
      "buyer_protection"
    ],
    "submit_blocking_assist_keywords": [
      "必填",
      "请填写",
      "请完善"
    ],
    "draft_verification": {
      "enabled": true,
      "server_reopen_after_save": true,
      "refresh_after_save": true,
      "settle_seconds": 1.2,
      "refresh_wait_seconds": 4,
      "require_title": true,
      "require_main_image": true,
      "minimum_main_image_count": 1,
      "require_description": true,
      "main_image_wait_seconds": 30,
      "main_image_poll_seconds": 0.8,
      "require_square_main_image": true,
      "description_image_wait_seconds": 30,
      "description_image_poll_seconds": 0.8,
      "minimum_description_image_count": 1,
      "require_send_address": true,
      "strict_send_address_persist": true,
      "require_delivery_service": true,
      "require_logistics_dimensions": true,
      "strict_logistics_persist": true,
      "required_logistics_fields": [
        {
          "name": "length",
          "source": "length_cm"
        },
        {
          "name": "width",
          "source": "width_cm"
        },
        {
          "name": "height",
          "source": "height_cm"
        },
        {
          "name": "weight",
          "source": "weight_g"
        }
      ],
      "require_buyer_protection": true,
      "strict_buyer_protection_persist": true,
      "buyer_protection_source": "buyer_protection_ship_time",
      "buyer_protection_default_value": "24小时发货",
      "buyer_protection_expected_code": "essxsfh",
      "buyer_protection_step_template": [
        {
          "from": 1,
          "service_name": "24小时发货",
          "service_code": "essxsfh"
        }
      ],
      "require_specs": true,
      "required_spec_labels": [
        "颜色"
      ],
      "forbidden_assist_keywords": [
        "商品主图为必填项",
        "请填写图文详情",
        "第一个区间的购买数量必须",
        "第1行的发货时间为必填项"
      ],
      "stale_assist_keywords_when_description_images_ready": [
        "请填写图文详情"
      ]
    },
    "draft_request_patch": {
      "enabled": true,
      "timeout_seconds": 5,
      "capture_body_chars": 4000,
      "buyer_protection_include_sps_code": true,
      "buyer_protection_source": "buyer_protection_ship_time",
      "buyer_protection_default_value": "24小时发货",
      "buyer_protection_step_template": [
        {
          "from": 1,
          "service_name": "24小时发货",
          "service_code": "essxsfh"
        }
      ],
      "quotation_type_text": "按产品规格报价",
      "unit_text": "件",
      "min_begin_amount": "1",
      "response_failure_keywords": [
        "系统错误",
        "发布失败",
        "保存失败"
      ]
    },
    "draft_page_state_patch": {
      "enabled": true,
      "buyer_protection_include_sps_code": true,
      "buyer_protection_source": "buyer_protection_ship_time",
      "buyer_protection_default_value": "24小时发货",
      "buyer_protection_step_template": [
        {
          "from": 1,
          "service_name": "24小时发货",
          "service_code": "essxsfh"
        }
      ],
      "cat_props": [
        {
          "label": "材质",
          "source": "material",
          "default_value": "人造板"
        },
        {
          "label": "台面材质",
          "source": "material",
          "default_value": "人造板"
        }
      ]
    },
    "success_extractors": [
      {
        "name": "platform_link_id",
        "target": "platform_link_id",
        "action": "extract",
        "from": "current_url",
        "pattern": "/offer/(\\d+)",
        "group": 1,
        "required": false,
        "selector": {}
      },
      {
        "name": "platform_link_url",
        "target": "platform_link_url",
        "action": "extract",
        "from": "current_url",
        "pattern": "(https?://[^\\s]*?/offer/\\d+[^\\s]*)",
        "group": 1,
        "required": false,
        "selector": {}
      }
    ],
    "steps": [
      {
        "name": "open_publish_page",
        "action": "manual",
        "message": "请先手动进入 1688 商家后台的商品发布页面，页面加载完成后按回车继续..."
      },
      {
        "name": "category",
        "action": "category_path",
        "source": "resolved_category_levels",
        "required": false,
        "force_reselect": true,
        "retry": 2,
        "select_url": "https://offer-new.1688.com/select.htm",
        "confirm_selector": {
          "by": "css",
          "value": "#submitButton"
        },
        "selector": {
          "by": "css",
          "value": "#guid-catNamer button"
        }
      },
      {
        "name": "title",
        "action": "input",
        "source": "title",
        "required": true,
        "selector": {
          "by": "css",
          "value": "#guid-title input[maxlength=\"60\"]"
        }
      },
      {
        "name": "price",
        "action": "input",
        "source": "price",
        "required": true,
        "selector": {
          "by": "css",
          "value": "#guid-priceRange td[data-next-table-col=\"2\"] input"
        }
      },
      {
        "name": "price_begin_amount",
        "action": "input",
        "value": "1",
        "required": true,
        "selector": {
          "by": "css",
          "value": "#guid-priceRange td[data-next-table-col=\"1\"] input"
        }
      },
      {
        "name": "quantity",
        "action": "input",
        "source": "quantity",
        "required": true,
        "selector": {
          "by": "css",
          "value": "#guid-totalSales input"
        }
      },
      {
        "name": "brand",
        "action": "combobox",
        "source": "brand",
        "required": false,
        "selector": {
          "by": "xpath",
          "value": "//div[@id='guid-catProp']//div[contains(@class,'decorate-cat-prop')][.//span[contains(@class,'cat-prop-label')][contains(normalize-space(.), '品牌')]]//input[@role='combobox' or @type='text']"
        }
      },
      {
        "name": "material",
        "action": "combobox",
        "source": "material",
        "required": false,
        "selector": {
          "by": "xpath",
          "value": "//div[@id='guid-catProp']//div[contains(@class,'decorate-cat-prop')][.//span[contains(@class,'cat-prop-label')][contains(normalize-space(.), '材质')]]//input[@role='combobox' or @type='text']"
        }
      },
      {
        "name": "category_defaults",
        "action": "category_prop_defaults",
        "required": false,
        "profiles": {
          "bedside_table": {
            "rules": [
              {
                "label": "风格",
                "value": "现代简约",
                "select_first_option_if_unmatched": true
              },
              {
                "label": "品牌",
                "source": "brand",
                "type": "input",
                "default_value": "速班达"
              },
              {
                "label": "空间",
                "value": "卧室",
                "select_first_option_if_unmatched": false
              },
              {
                "label": "是否配送上门",
                "value": "送货至楼下",
                "select_first_option_if_unmatched": true
              },
              {
                "label": "是否提供安装服务",
                "value": "否",
                "select_first_option_if_unmatched": true
              },
              {
                "label": "适用场所",
                "value": "卧室",
                "select_first_option_if_unmatched": false
              },
              {
                "label": "是否一般纳税人",
                "value": "否",
                "select_first_option_if_unmatched": true
              },
              {
                "label": "是否有专利",
                "value": "否",
                "select_first_option_if_unmatched": true
              },
              {
                "label": "适用对象",
                "value": "成人",
                "type": "multiselect",
                "select_first_if_empty": true,
                "select_first_option_if_unmatched": true
              },
              {
                "label": "功能",
                "value": "收纳储物",
                "type": "multiselect",
                "select_first_if_empty": true,
                "select_first_option_if_unmatched": true
              },
              {
                "label": "是否有3D模型",
                "value": "否",
                "select_first_option_if_unmatched": true
              },
              {
                "label": "台面材质",
                "source": "material",
                "default_value": "人造板",
                "select_first_option_if_unmatched": true
              },
              {
                "label": "是否组装",
                "value": "组装",
                "select_first_option_if_unmatched": true
              },
              {
                "label": "设计元素",
                "value": "其它",
                "select_first_option_if_unmatched": true
              },
              {
                "label": "是否带滚轮",
                "value": "否",
                "select_first_option_if_unmatched": true
              }
            ]
          },
          "*": {
            "rules": [
              {
                "label": "品牌",
                "source": "brand",
                "type": "input",
                "default_value": "速班达"
              }
            ]
          }
        }
      },
      {
        "name": "spec_values",
        "action": "spec_values",
        "required": false,
        "profiles": {
          "bedside_table": {
            "rules": [
              {
                "label": "颜色",
                "source": "color",
                "required": true,
                "source_candidates": [
                  "color",
                  "company_sku_names",
                  "outer_sku"
                ],
                "multi_value": true,
                "commit_key": "tab",
                "split_pattern": "\\s*(?:\\||,|，|;|；|\\n)+\\s*"
              },
              {
                "label": "尺寸",
                "source": "size",
                "required": false,
                "commit_key": "tab"
              }
            ]
          },
          "*": {
            "rules": [
              {
                "label": "颜色",
                "source": "color",
                "required": true,
                "source_candidates": [
                  "color",
                  "company_sku_names",
                  "outer_sku"
                ],
                "multi_value": true,
                "commit_key": "tab",
                "split_pattern": "\\s*(?:\\||,|，|;|；|\\n)+\\s*"
              },
              {
                "label": "尺寸",
                "source": "size",
                "required": false,
                "commit_key": "tab"
              }
            ]
          }
        }
      },
      {
        "name": "sku_table_rows",
        "action": "sku_table_rows",
        "required": false,
        "source": "sku_rows"
      },
      {
        "name": "main_image",
        "action": "picker_upload",
        "source": "main_images",
        "max_files": 4,
        "minimum_image_count": 4,
        "upload_via_react_bridge": true,
        "bridge_selector": {
          "by": "css",
          "value": "#guid-primaryPicture"
        },
        "bridge_slot_index": 0,
        "ensure_square_first_image": true,
        "replace_existing_non_square": true,
        "required": true,
        "selector": {
          "by": "xpath",
          "value": "(//div[@id='guid-primaryPicture']//div[contains(@class,'picture-sort-list')]//div[contains(@class,'module-picture-cover-wrapper') and contains(@class,'cover-empty')])[1]"
        },
        "dialog_selector": {
          "by": "css",
          "value": "div.ibank-picker-dialog, div.ui-dialog"
        },
        "frame_selector": {
          "by": "css",
          "value": "iframe.picker-frame"
        },
        "upload_tab_selector": {
          "by": "css",
          "value": "li.tab-upload"
        },
        "album_select_selector": {
          "by": "css",
          "value": "select"
        },
        "file_input_selector": {
          "by": "css",
          "value": ".tabs-content.upload input[type='file']"
        },
        "insert_selector": {
          "by": "css",
          "value": "a.button.submit"
        },
        "insert_count_selector": {
          "by": "css",
          "value": ".insert-header"
        }
      },
      {
        "name": "detail_images",
        "action": "tinymce_images",
        "source": "detail_images",
        "multiple": true,
        "auto_create_album_when_full": true,
        "require_album_ready": true,
        "auto_album_name_prefix": "AUTO_DETAIL",
        "auto_album_access": "private",
        "auto_album_access_label": "不公开",
        "auto_album_capacity": 500,
        "create_album_link_selector": {
          "by": "css",
          "value": ".album-create"
        },
        "create_album_name_input_selector": {
          "by": "css",
          "value": "input.create-field[name='name']"
        },
        "create_album_private_selector": {
          "by": "xpath",
          "value": "//*[@id='album-manager-pri'] | //label[@for='album-manager-pri'] | //*[self::label or self::span or self::a][contains(normalize-space(.),'不公开')]"
        },
        "create_album_submit_selector": {
          "by": "css",
          "value": "a.button.insert"
        },
        "required": false,
        "fallback_picker_selector": {
          "by": "xpath",
          "value": "(//div[@id='guid-primaryPicture']//div[contains(@class,'picture-sort-list')]//div[contains(@class,'module-picture-cover-wrapper') and contains(@class,'cover-empty')])[1]"
        },
        "dialog_selector": {
          "by": "css",
          "value": "div.ibank-picker-dialog, div.ui-dialog"
        },
        "frame_selector": {
          "by": "css",
          "value": "iframe.picker-frame"
        },
        "upload_tab_selector": {
          "by": "css",
          "value": "li.tab-upload"
        },
        "file_input_selector": {
          "by": "css",
          "value": ".tabs-content.upload input[type='file']"
        },
        "insert_selector": {
          "by": "css",
          "value": "a.button.submit"
        },
        "selector": {
          "by": "css",
          "value": "[id^='tinyMCE-']"
        }
      },
      {
        "name": "description",
        "action": "tinymce",
        "source": "description",
        "required": false,
        "append_mode": "prepend",
        "selector": {
          "by": "css",
          "value": "[id^='tinyMCE-']"
        }
      },
      {
        "name": "ship_from_template",
        "action": "combobox",
        "source": "ship_from_template",
        "required": false,
        "selector": {
          "by": "css",
          "value": "#rc_select_3"
        }
      },
      {
        "name": "freight_template",
        "action": "combobox",
        "source": "freight_template",
        "required": false,
        "selector": {
          "by": "css",
          "value": "#rc_select_6"
        }
      },
      {
        "name": "ship_time_template",
        "action": "combobox",
        "source": "ship_time_template",
        "required": false,
        "selector": {
          "by": "css",
          "value": "#rc_select_7"
        }
      },
      {
        "name": "buyer_protection_ship_time",
        "action": "ant_select",
        "source": "buyer_protection_ship_time",
        "default_value": "24小时发货",
        "required": false,
        "select_first_option_if_unmatched": true,
        "selector": {
          "by": "xpath",
          "value": "//div[@id='guid-buyerProtection']//div[contains(@class,'ant-select-selector')]"
        }
      },
      {
        "name": "sanitize_spec_inputs",
        "action": "sanitize_inputs",
        "input_selector": "input, textarea",
        "skip_readonly": true,
        "selector": {
          "by": "css",
          "value": ""
        }
      },
      {
        "name": "assert_no_publish_errors",
        "action": "assert_no_errors",
        "error_detection": {
          "enabled": true,
          "timeout_seconds": 0,
          "keywords": [
            "发布失败",
            "产品规格包含表情符号",
            "资料失效",
            "日志失效"
          ],
          "message_selector": {
            "by": "css",
            "value": "#guid-assistBoard .info-list li div, .ant-message-notice-content, .ant-notification-notice-description, .ant-modal-body, .next-dialog-body"
          },
          "close_selector": {
            "by": "css",
            "value": ".ant-modal-root .ant-modal-close, .next-dialog-close, .ui-dialog-titlebar-close"
          }
        }
      },
      {
        "name": "extract_match_source_id",
        "action": "extract",
        "target": "match_source_id",
        "required": false,
        "selector": {
          "by": "css",
          "value": ""
        }
      },
      {
        "name": "manual_review",
        "action": "manual",
        "message": "请检查 1688 发布页中的类目、运费和规格设置，确认后回车继续..."
      }
    ]
  }
}